# Copy to .env and fill in YOUR OWN values. Never commit the real .env file.
# Each bot is its own service: on a PaaS, set these as the service's environment variables.
# Running both locally? Put the admin bot's values (different TELEGRAM_BOT_TOKEN,
# different WEBHOOK_BASE_URL) in admin_bot/.env, which takes priority over this file.

# --- Telegram (both bots; use a DIFFERENT bot token for each) ---
TELEGRAM_BOT_TOKEN=123456:replace-with-token-from-BotFather
WEBHOOK_BASE_URL=https://your-app.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=generate-a-long-random-string
ADMIN_CHAT_ID=123456789
PORT=8080

# --- LLM: any OpenAI-compatible endpoint (both bots) ---
GAPGPT_API_KEY=sk-replace-me
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini

# --- PostgreSQL (both bots share one database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopbot
DB_USER=postgres
DB_PASSWORD=replace-me
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20

# --- Shop bot only ---
# Destination account that payment receipts are verified against
STORE_CARD_NUMBER=0000000000000000
STORE_CARD_HOLDER=Card Holder Name
STORE_BANK_NAME=Bank Name
STORE_NAME=My Clothing Store
DELIVERY_MIN_DAYS=2
DELIVERY_MAX_DAYS=4
REMINDER_DELAY_SECONDS=3600
REMINDER_POLL_INTERVAL_SECONDS=15
CATALOG_CACHE_TTL_SECONDS=30
